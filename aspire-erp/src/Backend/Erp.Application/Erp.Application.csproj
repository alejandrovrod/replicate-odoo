<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Erp.Domain\Erp.Domain.csproj" />
  </ItemGroup>

  <!-- Industry vertical seed packs (workflow Fase 5): embedded so ApplyPreset works without
       file-system access in any host (API, tests, tooling). -->
  <ItemGroup>
    <EmbeddedResource Include="Presets\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
