<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Task 1.3: HTTP integration tests through the real Erp.Api pipeline. Mvc.Testing is
         pinned to 10.0.6 - the ASP.NET Core runtime installed with this machine's SDK
         (10.0.202) - and matches Erp.Api's Microsoft.AspNetCore.OpenApi line. Remaining
         packages mirror tests/Erp.Domain.UnitTests so the whole solution shares one xunit
         toolchain. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The API under test: WebApplicationFactory<Program> boots the full composition root
         (TenantResolutionMiddleware -> TenantMember policy -> MVC controllers -> CQRS handlers
         -> EF Core against the live dev SQL container). Microsoft.Data.SqlClient (used by the
         fixture's cleanup) flows transitively through Erp.Infrastructure's EF SQL Server
         provider. -->
    <ProjectReference Include="..\..\src\Backend\Erp.Api\Erp.Api.csproj" />
  </ItemGroup>

</Project>
