<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only packages (same set as Erp.Domain.UnitTests); Erp.Application itself keeps ZERO
         PackageReference of its own - Constitution Article I.3. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 3 target (Task 3.2/D12): the FIFO engine, the double-entry guard, the posting
         orchestration and the VI.4 idempotency policy, all tested against Domain contracts only. -->
    <ProjectReference Include="..\..\src\Backend\Erp.Domain\Erp.Domain.csproj" />
    <ProjectReference Include="..\..\src\Backend\Erp.Application\Erp.Application.csproj" />
    <!-- Block A-fill (08-crm): CrmModelMappingTests builds AppDbContext.Model OFFLINE (no
         connection opened) to verify the new Lead/Opportunity/CRMActivity configurations.
         Test-only reference; production code keeps the Application -> Domain direction. -->
    <ProjectReference Include="..\..\src\Backend\Erp.Infrastructure\Erp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
